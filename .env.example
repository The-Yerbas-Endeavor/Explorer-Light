# Explorer HTTP server. Keep it local when nginx is in front of it.
HOST=127.0.0.1
PORT=3001

# Yerbas Core JSON-RPC. Mainnet default RPC port is 9998.
RPC_PROTOCOL=http
RPC_HOST=127.0.0.1
RPC_PORT=9998

# Option A: explicit RPC credentials.
# RPC_USER=explorer
# RPC_PASSWORD=change-me

# Option B (default): same-host cookie authentication.
# RPC_COOKIE_FILE=/home/yerbas/.yerbascore/.cookie

RPC_TIMEOUT_MS=7000
RECENT_BLOCKS=12
CACHE_MS=5000

# Read-only AI/tool gateway.
AI_API_ENABLED=true
AI_MAX_BODY_BYTES=32768

# Optional read-only JSON market-price source used only by get_market_price.
# Keep blank until a trusted Yerbas market endpoint is selected.
# AI_MARKET_PRICE_URL=https://example.org/yerb-price.json

# Approximate network-map geolocation. Server-side only; browser clients never
# call the provider directly. Disable with NETWORK_MAP_ENABLED=false.
NETWORK_MAP_ENABLED=true
NETWORK_MAP_GEO_URL=https://hackmyip.com/api/bulk
NETWORK_MAP_GEO_CACHE_MS=86400000
NETWORK_MAP_GEO_TIMEOUT_MS=12000
