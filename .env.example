# Explorer HTTP server. Keep it local when nginx is in front of it.
HOST=127.0.0.1
PORT=3001

# Yerbas Core JSON-RPC. Mainnet default RPC port is 9998.
RPC_PROTOCOL=http
RPC_HOST=127.0.0.1
RPC_PORT=9998

# Option A: explicit RPC credentials.
# RPC_USER=explorer
# RPC_PASSWORD=change-me

# Option B (default): same-host cookie authentication.
# RPC_COOKIE_FILE=/home/yerbas/.yerbascore/.cookie

RPC_TIMEOUT_MS=7000
RECENT_BLOCKS=12
CACHE_MS=5000
